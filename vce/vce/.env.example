# Keep real Stripe keys in vce/.env locally and Azure App Settings in production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_FRONTEND_URL=http://127.0.0.1:5173

# Release switches are opt-in. Keep these false until each production rollout
# stage has passed its smoke checks.
BILLING_CHECKOUT_ENABLED=False
PAID_ACCESS_ENFORCEMENT_ENABLED=False
REFERRALS_ENABLED=False

# Production must use the matching live-mode price IDs. Local test IDs are
# configured in settings_local.py.
STRIPE_PRICE_SELF_STUDY_MONTHLY=price_replace_me
STRIPE_PRICE_SELF_STUDY_ANNUAL=price_replace_me
STRIPE_PRICE_SUPPORTED_MONTHLY=price_replace_me
STRIPE_PRICE_SUPPORTED_ANNUAL=price_replace_me

# Create these as one-time, fixed-amount AUD coupons in Stripe: $19 and $35.
STRIPE_REFERRAL_COUPON_SELF_STUDY=coupon_replace_me
STRIPE_REFERRAL_COUPON_SUPPORTED=coupon_replace_me
